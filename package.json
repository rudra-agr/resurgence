    "ag-grid-react": "32.3.3",
    "chart.js": "^4.6.1",
    "next": "14.2.35",
    "prisma": "6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.16.0",
