# Copy to .env.local and fill in. Never commit .env.local
DATABASE_URL=your-database-url
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=yur-32+random-characters
# Passwords used only by `npx prisma db seed` (not stored in code)
SEED_ADMIN_PASSWORD=your-admin-password
SEED_COORDINATOR_PASSWORD=  your-coordinator-password
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET= your-paypal-client-secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Optional, defaults to the sandbox
PAYPAL_BASE=your-paypal-base-url
CHANNEL3_API_KEY=user-channel3-api-key
GROQ_API_KEY=user-groq-api-key
# Optional. Defaults to llama-3.3-70b-versatile. GROQ_MODELS = comma-separated fallback list.
GROQ_MODEL=groq-model-name
# From the PayPal developer dashboard, Webhooks, after you add your site URL
PAYPAL_WEBHOOK_ID= paypal-webhook-id
