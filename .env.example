# Copy to .env.local and fill in. Never commit .env.local
DATABASE_URL=
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Passwords used only by `npx prisma db seed` (not stored in code)
SEED_ADMIN_PASSWORD=
SEED_COORDINATOR_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional, defaults to the sandbox
PAYPAL_BASE=
CHANNEL3_API_KEY=
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile. GROQ_MODELS = comma-separated fallback list.
GROQ_MODEL=